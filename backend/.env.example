DELAWARE_CAMPAIGN_FINANCE_ENABLED=false
DELAWARE_CAMPAIGN_FINANCE_SYNC_ENABLED=false
DELAWARE_CAMPAIGN_FINANCE_RAW_DATA_REFRESH_ENABLED=false

# Alabama campaign finance (docs/plans/plan-alabama-finance.md)
