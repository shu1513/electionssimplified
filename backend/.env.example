# Idaho campaign finance (docs/plans/idaho-finance.md)
# Sunshine (Civix CFIS) JSON API, anonymous. The read flag is free read-side —
# keep it ON in the real backend/.env once migration 268 is applied. Sync and
# raw refresh fetch the live API (search rows carry donor names and cities,
# cached under restricted local storage) and stay off unless a batch run is
# intended.
IDAHO_CAMPAIGN_FINANCE_ENABLED=false
IDAHO_CAMPAIGN_FINANCE_SYNC_ENABLED=false
IDAHO_CAMPAIGN_FINANCE_RAW_DATA_REFRESH_ENABLED=false

# Arkansas campaign finance (docs/plans/plan-arkansas-finance.md)
# The auto-link and sync CLIs hit the live CFIS API; keep the sync gate off
# unless running an intentional link or sync pass.
ARKANSAS_CAMPAIGN_FINANCE_ENABLED=false
ARKANSAS_CAMPAIGN_FINANCE_SYNC_ENABLED=false

# Kansas campaign finance (docs/plans/plan-kansas-finance.md)
# Viewer exports and scanned filings carry contributor names/addresses under
