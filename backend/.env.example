RHODE_ISLAND_ERTS_RAW_DATA_REFRESH_ENABLED=false

# Denver campaign finance
# Master switch for the isolated Denver SearchLight finance module (municipal
# filers are not in Colorado TRACER). The read flag is free read-side — keep
# it ON in the real backend/.env once migration 237 is applied (see
# docs/plans/plan-denver-finance.md); sync stays off until a run is intended. There is
