DATABASE_URL=postgresql://localhost:5432/voteapp
REDIS_URL=redis://localhost:6379
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=90000
ANTHROPIC_WEB_SEARCH_MAX_USES=3
PROMPT_VERSION=state_resources_v2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Global AI kill-switch. ALL outbound AI provider calls (OpenAI, Anthropic,
# Gemini) are blocked unless AI_API_CALLS_ALLOWED=true is set. Never set it in
# .env — that would re-enable every automatic caller. Pass it inline for an
# intentional manual run, e.g.:
#   AI_API_CALLS_ALLOWED=true npm run elections:enrich
# AI_API_CALLS_ALLOWED=false
CENSUS_API_KEY_1=
CENSUS_API_KEY_2=
CENSUS_API_KEY_3=
DATAVERSE_GUESTBOOK_NAME="Elections Simplified Historical Contest Importer"
DATAVERSE_GUESTBOOK_EMAIL=data-import@example.invalid
DATAVERSE_GUESTBOOK_INSTITUTION="Elections Simplified"
DATAVERSE_GUESTBOOK_POSITION="Data importer"
OBS_SPIKE_MIN_EVENTS=20
OBS_REJECT_SPIKE_RATE=0.25
OBS_RETRY_SPIKE_RATE=0.25
OBS_FAILED_SPIKE_RATE=0.25
OBS_REASON_SPIKE_COUNT=10
# The recurring state_resources refresh job is skipped unless this is "true"
# (manual --force trigger still runs). It also makes AI calls, so a real run
# additionally needs AI_API_CALLS_ALLOWED=true on the worker process.
STATE_RESOURCES_SCHEDULER_ENABLED=false
STATE_RESOURCES_SCHEDULER_QUEUE=state_resources_maintenance
STATE_RESOURCES_MONTHLY_CRON="0 3 1 * *"
STATE_RESOURCES_MONTHLY_TZ=UTC
STATE_RESOURCES_SCHEDULER_MAX_PASSES=3
STATE_RESOURCES_SCHEDULER_BATCH_SIZE=200
STATE_RESOURCES_SCHEDULER_BLOCK_MS=250

# Address API
ADDRESS_API_HOST=127.0.0.1
ADDRESS_API_PORT=3001
ADDRESS_API_ALLOWED_ORIGINS=http://localhost:3000
ADDRESS_API_RATE_LIMIT_ENABLED=true
ADDRESS_API_RATE_LIMIT_WINDOW_MS=60000
ADDRESS_API_RATE_LIMIT_MAX_REQUESTS=60
ADDRESS_API_RATE_LIMIT_MAX_BUCKETS=10000
# First-party usage analytics intake (POST /api/usage/events; docs/plans/
# usage-analytics.md). A WRITE feature, so it defaults off and stays off
# in dev unless you are testing it; production enables it in render.yaml
# together with the frontend's VITE_USAGE_ANALYTICS_ENABLED. Retention (90-
# day purge) runs regardless of this flag.
USAGE_ANALYTICS_ENABLED=false
# Optional proxy-aware rate limit keying.
# SECURITY: Only set this when a trusted proxy injects the header and strips any
# client-supplied copy. If unset, rate limiting uses the direct socket IP.
# Common trusted-proxy values: X-Forwarded-For, CF-Connecting-IP, Fly-Client-IP.
# ADDRESS_API_TRUSTED_CLIENT_IP_HEADER=X-Forwarded-For
# Optional authenticated user boundary for POST /api/me/districts/initialize.
# SECURITY: Only set this when an authenticated gateway injects the header and
# strips any client-supplied copy. Browsers must not be trusted to set this.
# If unset, authenticated routes fail closed with 401.
# API_TRUSTED_USER_ID_HEADER=X-User-Id
# SECURITY: The server refuses to start when API_TRUSTED_USER_ID_HEADER is set
# while session auth is configured (AUTH_PUBLIC_BASE_URL present), unless this
# explicit override acknowledges the combined trust boundary.
# API_TRUSTED_USER_ID_HEADER_ALLOW_WITH_SESSIONS=false
ADDRESS_LOOKUP_CACHE_ENABLED=true
ADDRESS_LOOKUP_CACHE_TTL_SECONDS=1209600
# Google Places address autocomplete proxy (POST /api/address/autocomplete and
# .../retrieve). Endpoints are enabled only when the key is set. Create the key
# in Google Cloud and restrict it to the "Places API (New)" service only.
# Billing (Google Maps Platform pricing from March 2025, checked 2026-09-25):
# the frontend sends a per-entry session token. A session that ends in Place
# Details bills nothing for its autocomplete requests (Autocomplete Session
# Usage SKU is free); only the terminating Place Details Essentials request is
# billed (10k free/month, then $5 per 1k). An abandoned session (no Place
# Details) bills every autocomplete request under the Autocomplete Requests
# SKU (10k free/month, then $2.83 per 1k), so abandoned entries are the cost
# driver. Overage is pay-as-you-go on the linked billing account; there is no
# hard cap unless one is set in Google Cloud quotas. Google ToS forbids
# caching/storing responses — the proxy must stay pass-through.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_TIMEOUT_MS=8000
CENSUS_ADDRESS_GEOCODER_BENCHMARK=Public_AR_Current
CENSUS_ADDRESS_GEOCODER_VINTAGE=ACS2024_Current
CENSUS_ADDRESS_GEOCODER_LAYERS=all
CENSUS_ADDRESS_GEOCODER_TIMEOUT_MS=10000

# Auth (email/password accounts)
# Master switch: auth endpoints are enabled only when AUTH_PUBLIC_BASE_URL is
# set (and Redis is reachable for sessions). It is the frontend origin used in
# verification/reset email links, e.g. https://app.example.com.
# AUTH_PUBLIC_BASE_URL=http://localhost:3000
# Mailer backend: "ses" (default) sends real email through AWS SESv2; "console"
# prints the verification/reset links to stdout for local development.
# AUTH_MAILER=ses
# Required for the SES mailer: a From address at a domain (or address) verified
# as an SES identity in AUTH_SES_REGION. SES identities are per-region, and a
# sandboxed SES account can only send TO verified addresses in that region.
# AUTH_FROM_EMAIL=noreply@example.com
# AUTH_REPLY_TO_EMAIL=support@example.com
# Region of the SES identity; falls back to AWS_REGION / AWS_DEFAULT_REGION.
# AUTH_SES_REGION=us-east-2
# SES credentials use the standard AWS credential chain (env vars, ~/.aws, IAM
# role). Prefer a dedicated send-only IAM user (policy: ses:SendEmail only).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# The candidate-follow digest sender (npm run notifications:digest) reuses the
# AUTH_* mailer settings above. NOTIFICATIONS_MAILER overrides AUTH_MAILER for
# the digest only; set it to "console" to print digests locally instead of
# sending through SES.
# NOTIFICATIONS_MAILER=console
# Daily digest scheduler (BullMQ). Upsert the recurring job with
# notifications:digest:scheduler:upsert, run it with
# notifications:digest:scheduler:worker.
# CANDIDATE_FOLLOW_DIGEST_SCHEDULER_QUEUE=candidate_follow_digest
# CANDIDATE_FOLLOW_DIGEST_DAILY_CRON=0 14 * * *
# CANDIDATE_FOLLOW_DIGEST_DAILY_TZ=UTC
# Daily district new-election alert emails (npm run
# notifications:new-elections). Upsert the schedule with
# notifications:new-elections:scheduler:upsert, run it with
# notifications:new-elections:scheduler:worker.
# NEW_ELECTION_ALERT_SCHEDULER_QUEUE=new_election_alert
# NEW_ELECTION_ALERT_DAILY_CRON=30 14 * * *
# NEW_ELECTION_ALERT_DAILY_TZ=UTC
# One-click unsubscribe links in notification emails (footer + List-Unsubscribe
# headers). Every SES notification sender refuses to start without both, so a
# real send can never go out without a link; console mailers and dry runs do
# not need them. The API server verifies the same secret at GET/POST
# /api/email/unsubscribe. URL is the PUBLIC address of that endpoint.
# NOTIFICATIONS_UNSUBSCRIBE_URL=https://api.example.com/api/email/unsubscribe
# NOTIFICATIONS_UNSUBSCRIBE_SECRET=<random string, 32+ chars>
# Physical postal address printed in the footer of issue broadcasts and member
# newsletters. Those sends can carry promotional content, which makes them
# commercial email under CAN-SPAM, and a valid physical address is mandatory
# there (a registered P.O. box or private mailbox qualifies; never a home
# address). The SES senders refuse to run without it.
# EMAIL_POSTAL_ADDRESS="Elections Simplified Inc., <street or PMB>, <city, state zip>"
# Session cookie attributes. Secure defaults to true when AUTH_PUBLIC_BASE_URL
# is https. SameSite=none requires Secure=true (startup fails otherwise).
# AUTH_SESSION_COOKIE_SAME_SITE=lax
# AUTH_SESSION_COOKIE_SECURE=false
# AUTH_SESSION_COOKIE_DOMAIN=
# AUTH_SESSION_COOKIE_PATH=/
# Auth endpoint rate limits (in-memory, per process). Buckets are shared across
# all auth endpoints and keyed by client IP and by normalized email.
# AUTH_API_RATE_LIMIT_ENABLED=true
# AUTH_API_RATE_LIMIT_WINDOW_MS=900000
# AUTH_API_RATE_LIMIT_MAX_REQUESTS_PER_IP=10
# AUTH_API_RATE_LIMIT_MAX_REQUESTS_PER_EMAIL=5
# AUTH_API_RATE_LIMIT_MAX_BUCKETS=10000

# Support payments / membership (docs/plans/membership-contributions.md).
# Money feature: stays OFF unless STRIPE_SECRET_KEY is set. Once it is, the
# other two are required (partial config fails the boot), and Checkout
# redirects need SITE_ORIGIN (or AUTH_PUBLIC_BASE_URL). The legal bundle that
# discloses Stripe (Terms 1.2 / Privacy 1.3) must be LIVE in production
# before this key is ever set there. Use a restricted key; the webhook secret
# comes from the dashboard's webhook endpoint (pin its API version to the
# SDK's pinned version), and the product id is the one dashboard-created
# Product shared by monthly and one-time payments.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MEMBERSHIP_PRODUCT_ID=

# Presidential elections
# Master presidential feature flag. When false, presidential schedulers/producers
# do not enqueue work and already-queued presidential profile/record drafts are
# acknowledged as no-ops. Normal non-presidential election pipelines still run.
PRESIDENTIAL_ELECTIONS_ENABLED=true

# Presidential roster research
PRESIDENTIAL_ROSTER_RESEARCH_DAILY_CRON="0 7 * * *"
PRESIDENTIAL_ROSTER_RESEARCH_DAILY_TZ=UTC
PRESIDENTIAL_ROSTER_RESEARCH_ENABLED=true
PRESIDENTIAL_ROSTER_RESEARCH_MAX_CYCLES_PER_RUN=10
PRESIDENTIAL_ROSTER_RESEARCH_QUEUE=presidential_roster_research
PRESIDENTIAL_ROSTER_RESEARCH_SCHEDULER_QUEUE=presidential_roster_research_scheduler

# Presidential primary date research
PRESIDENTIAL_PRIMARY_DATES_RESEARCH_ENABLED=true
PRESIDENTIAL_PRIMARY_DATES_RESEARCH_MAX_ROWS_PER_RUN=200
PRESIDENTIAL_PRIMARY_DATES_RESEARCH_MAX_STATES_PER_JOB=10
PRESIDENTIAL_PRIMARY_DATES_RESEARCH_MAX_JOBS_PER_RUN=20
PRESIDENTIAL_PRIMARY_DATE_RESEARCH_QUEUE=presidential_primary_date_research
PRESIDENTIAL_PRIMARY_DATE_RESEARCH_SCHEDULER_QUEUE=presidential_primary_date_research_maintenance
PRESIDENTIAL_PRIMARY_DATE_RESEARCH_DAILY_CRON="45 8 * * *"
PRESIDENTIAL_PRIMARY_DATE_RESEARCH_DAILY_TZ=UTC

# Presidential nominee research
PRESIDENTIAL_NOMINEE_RESEARCH_ENABLED=true
PRESIDENTIAL_NOMINEE_RESEARCH_MAX_CYCLES_PER_RUN=10
PRESIDENTIAL_NOMINEE_RESEARCH_QUEUE=presidential_nominee_research
PRESIDENTIAL_NOMINEE_RESEARCH_SCHEDULER_QUEUE=presidential_nominee_research_scheduler
PRESIDENTIAL_NOMINEE_RESEARCH_DAILY_CRON="15 8 * * *"
PRESIDENTIAL_NOMINEE_RESEARCH_DAILY_TZ=UTC

# Connecticut campaign finance
