CONNECTICUT_CAMPAIGN_FINANCE_SYNC_DAILY_CRON="35 9 * * *"
CONNECTICUT_CAMPAIGN_FINANCE_SYNC_DAILY_TZ=UTC
CONNECTICUT_ECRIS_RAW_DATA_REFRESH_QUEUE=connecticut_ecris_raw_data_refresh_maintenance
CONNECTICUT_ECRIS_RAW_DATA_REFRESH_DAILY_CRON="25 8 * * *"
CONNECTICUT_ECRIS_RAW_DATA_REFRESH_DAILY_TZ=UTC

