NORTH_CAROLINA_NCSBE_RAW_DATA_REFRESH_ENABLED=false

# Georgia campaign finance
# Master switch for the isolated Georgia Ethics Commission finance module.
# The read flag is free read-side — keep it ON in the real backend/.env once
# the migration is applied (see docs/plans/georgia_plan.md); sync/refresh stay off until
# their PRs ship.
GEORGIA_CAMPAIGN_FINANCE_ENABLED=false
GEORGIA_CAMPAIGN_FINANCE_SYNC_ENABLED=false
GEORGIA_ETHICS_RAW_DATA_REFRESH_ENABLED=false

# Missouri campaign finance
# Read, sync, and MEC portal refresh are independently gated. Raw artifacts
