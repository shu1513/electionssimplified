DENVER_CAMPAIGN_FINANCE_ENABLED=false
DENVER_CAMPAIGN_FINANCE_SYNC_ENABLED=false

# Austin (TX) city campaign finance
# Master switch for the isolated City of Austin campaign-finance module (City
# Clerk filings published as Socrata datasets on data.austintexas.gov; Austin
# filers are not in the Texas TEC or Houston modules). The read flag is free
# read-side — keep it ON in the real backend/.env once migration 243 is
# applied (see docs/plans/plan-austin-finance.md); sync queries Socrata live and stays
# off unless a batch run is intended. There is no raw-data-refresh flag.
# AUSTIN_SOCRATA_APP_TOKEN is optional (a free Socrata app token, not a user
# credential) — it lifts the shared-IP throttle on unauthenticated calls.
AUSTIN_CAMPAIGN_FINANCE_ENABLED=false
AUSTIN_CAMPAIGN_FINANCE_SYNC_ENABLED=false
AUSTIN_SOCRATA_APP_TOKEN=
