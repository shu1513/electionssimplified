ALASKA_APOC_IE_EXPENDITURES_CSV_PATH=
ALASKA_APOC_IE_CONTRIBUTIONS_CSV_PATH=
ALASKA_APOC_CAMPAIGN_INCOME_URL=https://aws.state.ak.us/ApocReports/CampaignDisclosure/CDIncome.aspx
ALASKA_APOC_IE_EXPENDITURES_URL=https://aws.state.ak.us/ApocReports/IndependentExpenditures/IEExpenditures.aspx
