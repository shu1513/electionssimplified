ALASKA_CAMPAIGN_FINANCE_ENABLED=false
ALASKA_CAMPAIGN_FINANCE_SYNC_ENABLED=false
ALASKA_CAMPAIGN_FINANCE_SYNC_SCHEDULER_QUEUE=alaska_candidate_finance_sync_maintenance
