{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "address:api",
        "--prefix",
        "backend"
      ],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_GEO_HINT=CA/Fresno/36.7378,-119.7871",
        "npm",
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082",
        "--offline"
      ],
      "cwd": "mobile",
      "port": 8082
    },
    {
      "name": "mobile-ios",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--ios"
      ],
      "cwd": "mobile",
      "port": 8081
    },
    {
      "name": "backend-worktree",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADDRESS_API_PORT=3101",
        "AUTH_MAILER=console",
        "CHATBOT_ENABLED=true",
        "CHATBOT_EMBEDDINGS_URL=http://localhost:8080",
        "USAGE_ANALYTICS_ENABLED=true",
        "npm",
        "run",
        "address:api",
        "--prefix",
        "backend"
      ],
      "port": 3101
    },
    {
      "name": "frontend-worktree",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADDRESS_API_PROXY_TARGET=http://127.0.0.1:3101",
        "API_INTERNAL_URL=http://127.0.0.1:3101",
        "VITE_CHATBOT_ENABLED=true",
        "VITE_USAGE_ANALYTICS_ENABLED=true",
        "DEV_GEO_HINT=CA/Fresno/36.7378,-119.7871",
        "npm",
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5273,
      "autoPort": true
    }
  ]
}